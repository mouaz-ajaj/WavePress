<Window x:Class="WavePress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WavePress.ViewModels"
        xmlns:cvt="clr-namespace:WavePress.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="WavePress — Audio Compression Studio"
        Width="1320" Height="820"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundMainBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <cvt:BoolToVisibilityConverter x:Key="BoolToVis" />
        <cvt:InverseBoolConverter x:Key="InverseBool" />
        <cvt:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <cvt:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--  HEADER BAR                                -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource HeaderGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- اسم التطبيق + أيقونة -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎵" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="WavePress" Style="{StaticResource HeaderText}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Audio Compression Studio" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="12,2,0,0" />
                </StackPanel>

                <!-- حالة الملف -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                               Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LoadedFileName}" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource PrimaryLightBrush}" />
                </StackPanel>

                <!-- Version -->
                <TextBlock Grid.Column="2" Text="v1.0" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  SIDEBAR                                   -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                Background="{StaticResource SidebarGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,16">
                    <TextBlock Text="NAVIGATION" Style="{StaticResource CaptionText}"
                               Margin="16,0,0,10" FontWeight="SemiBold" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <Button Style="{StaticResource SidebarButton}" Content="📁  Import Audio"
                            Click="ScrollToSection" Tag="ImportSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="▶️  Audio Preview"
                            Click="ScrollToSection" Tag="PlaybackSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="ℹ️  File Properties"
                            Click="ScrollToSection" Tag="InfoSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="⚙️  Compression Settings"
                            Click="ScrollToSection" Tag="SettingsSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="📊  Performance Monitor"
                            Click="ScrollToSection" Tag="MonitorSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="📋  Report"
                            Click="ScrollToSection" Tag="ReportSection" />
                    <Button Style="{StaticResource SidebarButton}" Content="💾  Save Output"
                            Click="ScrollToSection" Tag="SaveSection" />

                    <Separator Margin="16,16" Background="{StaticResource BorderBrush}" />

                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource CaptionText}"
                               Margin="16,0,0,10" FontWeight="SemiBold" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <Button Style="{StaticResource SidebarButton}" Content="🔄  Reset All"
                            Command="{Binding ResetCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  MAIN CONTENT AREA                         -->
        <!-- ══════════════════════════════════════════ -->
        <ScrollViewer x:Name="MainScroller" Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,8,16,16">
            <StackPanel>

                <!-- ─── ROW 1: Import + File Info ─── -->
                <WrapPanel Orientation="Horizontal">

                    <!-- CARD: Import Audio -->
                    <Border x:Name="ImportSection" Style="{StaticResource CardBorder}" Width="400" MinHeight="170">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="📁 Import Audio" />

                            <!-- Drag & Drop Zone -->
                            <Border Style="{StaticResource DropZoneBorder}" 
                                    AllowDrop="True" Drop="DropZone_Drop" DragOver="Window_DragOver"
                                    Visibility="{Binding IsFileLoaded, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎵" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Drag &amp; Drop Audio File Here" Style="{StaticResource BodyText}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="WAV or MP3" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- عرض اسم الملف المحمَّل -->
                            <Border Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource PrimaryMutedBrush}"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LoadedFileName}" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource SecondaryButton}" Content="Browse..."
                                    Command="{Binding BrowseCommand}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- CARD: File Properties -->
                    <Border x:Name="InfoSection" Style="{StaticResource CardBorder}" Width="400" MinHeight="170">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ℹ️ File Properties" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="File Size" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayFileSize}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayDuration}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Rate" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplaySampleRate}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Channels" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayChannels}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Bit Depth" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayBitsPerSample}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Bit Rate" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DisplayBitRate}" Style="{StaticResource InfoValue}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Codec" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DisplayCodec}" Style="{StaticResource InfoValue}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- ─── ROW 2: Playback ─── -->
                <Border x:Name="PlaybackSection" Style="{StaticResource CardBorder}" MaxWidth="824">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="▶️ Audio Preview" />

                        <!-- Progress Slider -->
                        <Grid Margin="0,4,0,8">
                            <ProgressBar Style="{StaticResource ModernProgressBar}" Height="6"
                                         Value="{Binding PlaybackProgress}" Minimum="0" Maximum="100" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Content="▶  Play"
                                        Command="{Binding PlayCommand}" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsFileLoaded}"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="⏸  Pause"
                                        Command="{Binding PausePlaybackCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="⏹  Stop"
                                        Command="{Binding StopPlaybackCommand}"
                                        IsEnabled="{Binding IsFileLoaded}" />
                            </StackPanel>

                            <!-- Time display -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPositionText}" Style="{StaticResource ValueText}" />
                                <TextBlock Text=" / " Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── ROW 3: Compression Settings ─── -->
                <Border x:Name="SettingsSection" Style="{StaticResource CardBorder}" MaxWidth="824">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="⚙️ Compression Settings" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Algorithm Selection -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="Algorithm" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding AlgorithmNames}"
                                          SelectedIndex="{Binding SelectedAlgorithmIndex}"
                                          IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Bits Per Sample -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Bits Per Sample" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding TargetBitsPerSample, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Quantization Levels -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="Quantization Levels" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding QuantizationLevels, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Delta Step Size -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Delta Step Size" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding DeltaStepSize, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Adaptive Factor -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="Adaptive Factor" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding AdaptiveFactor, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Output File Name -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                <TextBlock Text="Output File Name" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Content="🔧  Compress"
                                        Command="{Binding CompressCommand}" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsFileLoaded}"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="📂  Decompress"
                                        Command="{Binding DecompressCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" />
                                <Button Style="{StaticResource DangerButton}" Content="✖  Cancel"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="🔄  Reset"
                                        Command="{Binding ResetCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── ROW 4: Performance Monitor ─── -->
                <Border x:Name="MonitorSection" Style="{StaticResource CardBorder}" MaxWidth="824">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="📊 Performance Monitor" />

                        <!-- Progress Bar -->
                        <Grid Margin="0,0,0,12">
                            <ProgressBar Style="{StaticResource ModernProgressBar}" Height="10"
                                         Value="{Binding ProgressValue}" Minimum="0" Maximum="100" />
                        </Grid>

                        <!-- Stats Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Progress" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ValueText}" HorizontalAlignment="Center"
                                           FontSize="18">
                                    <TextBlock.Text>
                                        <Binding Path="ProgressValue" StringFormat="{}{0:F0}%" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Compression Ratio" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentCompressionRatio}" Style="{StaticResource ValueText}"
                                           HorizontalAlignment="Center" FontSize="18" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Speed" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentProcessingSpeed}" Style="{StaticResource ValueText}"
                                           HorizontalAlignment="Center" FontSize="18" />
                            </StackPanel>
                        </Grid>

                        <!-- Phase -->
                        <TextBlock Text="{Binding ProgressPhase}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />

                        <!-- Charts -->
                        <Grid Height="160">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Compression Ratio Chart -->
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Compression Ratio" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <lvc:CartesianChart Height="130"
                                                     Series="{Binding CompressionRatioSeries}"
                                                     XAxes="{Binding ChartXAxes}"
                                                     YAxes="{Binding ChartYAxes}"
                                                     TooltipPosition="Hidden"
                                                     ZoomMode="None" />
                            </StackPanel>

                            <!-- Processing Speed Chart -->
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Processing Speed" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <lvc:CartesianChart Height="130"
                                                     Series="{Binding ProcessingSpeedSeries}"
                                                     XAxes="{Binding ChartXAxes}"
                                                     YAxes="{Binding ChartYAxes}"
                                                     TooltipPosition="Hidden"
                                                     ZoomMode="None" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── ROW 5: Report + Save ─── -->
                <WrapPanel Orientation="Horizontal">

                    <!-- CARD: Report -->
                    <Border x:Name="ReportSection" Style="{StaticResource CardBorder}" Width="480" MinHeight="200">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="📋 Compression Report" />

                            <!-- قبل وجود تقرير -->
                            <TextBlock Text="No report yet — compress a file to see results."
                                       Style="{StaticResource CaptionText}" Margin="0,20"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVis}}" />

                            <!-- التقرير -->
                            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Original Size" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReportOriginalSize}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Compressed Size" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReportCompressedSize}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Saved" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReportSavedSize}" Style="{StaticResource InfoValue}"
                                               Foreground="{StaticResource SuccessBrush}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Saving %" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReportSavingPercentage}" Style="{StaticResource InfoValue}"
                                               Foreground="{StaticResource SuccessBrush}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Compression Ratio" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReportCompressionRatio}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Time Elapsed" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReportTimeElapsed}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Algorithm" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReportAlgorithm}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Output Path" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ReportOutputPath}" Style="{StaticResource InfoValue}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD: Save Output -->
                    <Border x:Name="SaveSection" Style="{StaticResource CardBorder}" Width="310" MinHeight="200">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="💾 Save Output" />

                            <TextBlock Text="After compression, save your compressed file (.wvp) or decompress and save as WAV."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <Button Style="{StaticResource PrimaryButton}" Content="💾  Save Compressed (.wvp)"
                                    Command="{Binding SaveCompressedCommand}" Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch" />

                            <Button Style="{StaticResource SecondaryButton}" Content="📂  Decompress &amp; Save WAV"
                                    Command="{Binding DecompressCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Bottom spacing -->
                <Border Height="20" />

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════ -->
        <!--  STATUS BAR                                -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</Window>
