<Window x:Class="WavePress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WavePress.ViewModels"
        xmlns:cvt="clr-namespace:WavePress.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="WavePress — Audio Compression Studio"
        Width="1220" Height="820"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BackgroundMainBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <!-- Custom Window Chrome — removes the default title bar and toolbar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <cvt:BoolToVisibilityConverter x:Key="BoolToVis" />
        <cvt:InverseBoolConverter x:Key="InverseBool" />
        <cvt:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <cvt:NullToVisibilityConverter x:Key="NullToVis" />
        <cvt:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="0*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <!-- Custom Title Bar -->
                <RowDefinition Height="*" />
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════ -->
            <!--  CUSTOM TITLE BAR                          -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D4FF" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="WavePress" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            Click="MaximizeRestoreButton_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════ -->
            <!--  MAIN LAYOUT                               -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════ -->
                <!--  MAIN CONTENT                              -->
                <!-- ══════════════════════════════════════════ -->
                <ScrollViewer x:Name="MainScroller" Grid.Row="0" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,8,12,16">

                        <!-- ─── HEADER AREA ─── -->
                        <Border Margin="8,8,8,4" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Audio Compression Studio" Style="{StaticResource HeaderText}" FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <Binding Path="LoadedFileName" FallbackValue="Import a WAV or MP3 file to get started"
                                                     TargetNullValue="Import a WAV or MP3 file to get started" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource DangerButton}" Content="Reset All"
                                            Command="{Binding ResetCommand}" Margin="0,0,16,0" Padding="12,6" FontSize="11" />
                                    <TextBlock Text="v1.0" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ─── ROW 1: Import + File Info ─── -->
                        <Grid Width="850" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CARD: Import Audio -->
                            <Border x:Name="ImportSection" Grid.Column="0" Style="{StaticResource CardBorder}" MinHeight="180" Margin="8,8,8,8" Grid.RowSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Card accent line at top -->
                                    <Border Grid.Row="0" Height="3" CornerRadius="2" Margin="-24,-24,-24,16"
                                            Background="{StaticResource AccentLineBrush}" 
                                            VerticalAlignment="Top" />

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Import Audio" />

                                        <!-- Drop Zone (when no file) -->
                                        <Border Style="{StaticResource DropZoneBorder}" 
                                                AllowDrop="True" Drop="DropZone_Drop" DragOver="Window_DragOver"
                                                Visibility="{Binding IsFileLoaded, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{StaticResource PrimaryColor}" Opacity="0.15" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="Drag &amp; Drop Audio File" Style="{StaticResource BodyText}"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="WAV or MP3 supported" Style="{StaticResource CaptionText}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Loaded File Display -->
                                        <Border Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource PrimaryMutedBrush}"
                                                CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{StaticResource SuccessColor}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding LoadedFileName}" Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>

                                        <Button Style="{StaticResource SecondaryButton}" Content="Browse Files..."
                                                Command="{Binding BrowseCommand}" Margin="0,8,0,0"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CARD: File Properties -->
                            <Border x:Name="InfoSection" Grid.Column="1" Style="{StaticResource CardBorder}" MinHeight="180" Margin="8,8,8,8" Grid.RowSpan="2">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="File Properties" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File Size" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayFileSize}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayDuration}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Rate" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplaySampleRate}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Channels" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayChannels}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bit Depth" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayBitsPerSample}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Bit Rate" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DisplayBitRate}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Codec" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DisplayCodec}" Style="{StaticResource InfoValue}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ─── ROW 2: Playback ─── -->
                        <Border x:Name="PlaybackSection" Style="{StaticResource CardBorder}" Width="850" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Audio Preview" />

                                <!-- Progress bar -->
                                <Grid Margin="0,4,0,14">
                                    <ProgressBar Style="{StaticResource ModernProgressBar}" Height="5"
                                                 Value="{Binding PlaybackProgress}" Minimum="0" Maximum="100" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Content="▶  Play"
                                                Command="{Binding PlayCommand}" Margin="0,0,10,0"
                                                IsEnabled="{Binding IsFileLoaded}"
                                                Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="⏸  Pause"
                                                Command="{Binding PausePlaybackCommand}" Margin="0,0,10,0"
                                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="⏹  Stop"
                                                Command="{Binding StopPlaybackCommand}"
                                                IsEnabled="{Binding IsFileLoaded}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentPositionText}" Style="{StaticResource ValueText}" FontSize="14" />
                                        <TextBlock Text="  /  " Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource CaptionText}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── ROW 3: Compression Settings ─── -->
                        <Border x:Name="SettingsSection" Style="{StaticResource CardBorder}" Width="850" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Compression Settings" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ── Algorithm ── -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                        <TextBlock Text="Algorithm" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="Select the compression algorithm. Each algorithm has different trade-offs between quality and compression ratio." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding AlgorithmNames}"
                                                  SelectedIndex="{Binding SelectedAlgorithmIndex}"
                                                  IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                                    </StackPanel>

                                    <!-- ── Bits Per Sample ── -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,14"
                                                Opacity="{Binding IsBitsPerSampleEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <TextBlock Text="Bits Per Sample" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="Number of bits used to store each audio sample after compression. Lower = smaller file, higher = better quality. Used by Nonlinear Quantization and DPCM." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding TargetBitsPerSample, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsBitsPerSampleEnabled}"
                                                 ToolTip="Used by: Nonlinear Quantization, DPCM" />
                                        <TextBlock Text="Used by: Nonlinear Quantization, DPCM"
                                                   Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                                                   Visibility="{Binding IsBitsPerSampleEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>

                                    <!-- ── Quantization Levels (Calculated, read-only) ── -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14"
                                                Opacity="0.5">
                                        <TextBlock Text="Quantization Levels" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="Calculated automatically: always 2^(Bits Per Sample). For example, 8 bits = 256 levels, 4 bits = 16 levels. Change Bits Per Sample to control this value indirectly." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding QuantizationLevelsDisplay, Mode=OneWay}"
                                                 IsEnabled="False"
                                                 IsReadOnly="True"
                                                 ToolTip="Calculated: 2^(Bits Per Sample). Control this by changing Bits Per Sample." />
                                        <TextBlock Text="Calculated: 2^BitsPerSample"
                                                   Style="{StaticResource CaptionText}" Margin="2,4,0,0" />
                                    </StackPanel>

                                    <!-- ── Delta Step Size ── -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,14"
                                                Opacity="{Binding IsDeltaStepSizeEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <TextBlock Text="Delta Step Size" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="The fixed step size (δ) added or subtracted per sample in Delta Modulation. Larger = tracks fast changes but adds noise; smaller = smoother but may lag. Used by Delta Modulation and Adaptive Delta Modulation." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding DeltaStepSize, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsDeltaStepSizeEnabled}"
                                                 ToolTip="Used by: Delta Modulation, Adaptive Delta Modulation" />
                                        <TextBlock Text="Used by: Delta Modulation, Adaptive Delta Mod."
                                                   Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                                                   Visibility="{Binding IsDeltaStepSizeEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>

                                    <!-- ── Adaptive Factor ── -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,14"
                                                Opacity="{Binding IsAdaptiveFactorEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <TextBlock Text="Adaptive Factor" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="Multiplier applied to the step size when the signal keeps moving in the same direction. Higher = faster step growth, better slope tracking. Used only by Adaptive Delta Modulation." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding AdaptiveFactor, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsAdaptiveFactorEnabled}"
                                                 ToolTip="Used by: Adaptive Delta Modulation only" />
                                        <TextBlock Text="Used by: Adaptive Delta Modulation only"
                                                   Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                                                   Visibility="{Binding IsAdaptiveFactorEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>

                                    <!-- ── Output File Name ── -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                        <TextBlock Text="Output File Name" Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="Name of the output compressed file (without extension). The .wvp extension will be added automatically." />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                                    </StackPanel>

                                    <!-- ── Action Buttons ── -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Compress"
                                                Command="{Binding CompressCommand}" Margin="0,0,10,0"
                                                IsEnabled="{Binding IsFileLoaded}" Padding="30,12"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Decompress"
                                                Command="{Binding DecompressCommand}" Margin="0,0,10,0"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Style="{StaticResource DangerButton}" Content="Cancel"
                                                Command="{Binding CancelCommand}" Padding="30,12"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── ROW 4: Performance Monitor ─── -->
                        <Border x:Name="MonitorSection" Style="{StaticResource CardBorder}" Width="850" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Performance Monitor" />

                                <!-- Progress Bar -->
                                <Grid Margin="0,0,0,16">
                                    <ProgressBar Style="{StaticResource ModernProgressBar}" Height="8"
                                                 Value="{Binding ProgressValue}" Minimum="0" Maximum="100" />
                                </Grid>

                                <!-- Stats Cards Row -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Stat: Progress -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceLightBrush}"
                                            CornerRadius="10" Padding="16,12" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Progress" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                            <TextBlock Style="{StaticResource ValueText}" HorizontalAlignment="Center"
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                <TextBlock.Text>
                                                    <Binding Path="ProgressValue" StringFormat="{}{0:F0}%" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stat: Compression Ratio -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceLightBrush}"
                                            CornerRadius="10" Padding="16,12" Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Compression Ratio" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentCompressionRatio}" Style="{StaticResource ValueText}"
                                                       HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Stat: Speed -->
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceLightBrush}"
                                            CornerRadius="10" Padding="16,12" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Speed" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentProcessingSpeed}" Style="{StaticResource ValueText}"
                                                       HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource SecondaryLightBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Phase -->
                                <TextBlock Text="{Binding ProgressPhase}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <!-- Charts -->
                                <Grid Height="150">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Compression Ratio" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <lvc:CartesianChart Height="120"
                                                             Series="{Binding CompressionRatioSeries}"
                                                             XAxes="{Binding ChartXAxes}"
                                                             YAxes="{Binding ChartYAxes}"
                                                             TooltipPosition="Hidden"
                                                             ZoomMode="None" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Processing Speed" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <lvc:CartesianChart Height="120"
                                                             Series="{Binding ProcessingSpeedSeries}"
                                                             XAxes="{Binding ChartXAxes}"
                                                             YAxes="{Binding ChartYAxes}"
                                                             TooltipPosition="Hidden"
                                                             ZoomMode="None" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── ROW 5: Report + Save ─── -->
                        <Grid Width="850" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- CARD: Report -->
                            <Border x:Name="ReportSection" Grid.Column="0" Style="{StaticResource CardBorder}" MinHeight="200">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Compression Report" />

                                    <!-- No report placeholder -->
                                    <Border Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVis}}"
                                            Background="{StaticResource SurfaceLightBrush}"
                                            CornerRadius="10" Padding="20" Margin="0,4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{StaticResource TextMuted}" Opacity="0.2" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="No report yet" Style="{StaticResource BodyText}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Compress a file to see results" Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Report -->
                                    <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>

                                            <!-- Original file on disk -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Original Size (Disk)" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReportOriginalSize}" Style="{StaticResource InfoValue}" />

                                            <!-- PCM raw size — what the algorithm actually worked on -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="PCM Size (Uncompressed)" Style="{StaticResource InfoLabel}"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReportPcmSize}" Style="{StaticResource InfoValue}"
                                                       Foreground="{StaticResource TextMutedBrush}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Compressed Size" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReportCompressedSize}" Style="{StaticResource InfoValue}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Saved vs. PCM" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReportSavedSize}" Style="{StaticResource InfoValue}"
                                                       Foreground="{StaticResource SuccessBrush}" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Saving %" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReportSavingPercentage}" Style="{StaticResource InfoValue}"
                                                       Foreground="{StaticResource SuccessBrush}" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Compression Ratio" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReportCompressionRatio}" Style="{StaticResource InfoValue}" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Time Elapsed" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReportTimeElapsed}" Style="{StaticResource InfoValue}" />

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Algorithm" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ReportAlgorithm}" Style="{StaticResource InfoValue}" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Output Path" Style="{StaticResource InfoLabel}" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ReportOutputPath}" Style="{StaticResource InfoValue}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD: Save Output -->
                            <Border x:Name="SaveSection" Grid.Column="1" Style="{StaticResource CardBorder}" Width="320" MinHeight="200">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Save Output" />

                                    <TextBlock Text="Save your compressed file (.wvp) or decompress and export as WAV."
                                               Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,24" />

                                    <Button Style="{StaticResource PrimaryButton}" Content="Save Compressed (.wvp)"
                                            Command="{Binding SaveCompressedCommand}" Margin="0,0,0,12"
                                            HorizontalAlignment="Stretch" />

                                    <Button Style="{StaticResource SecondaryButton}" Content="Decompress &amp; Save WAV"
                                            Command="{Binding DecompressCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="24" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════ -->
                <!--  STATUS BAR                                -->
                <!-- ══════════════════════════════════════════ -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{StaticResource SuccessColor}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
