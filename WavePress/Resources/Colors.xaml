<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!--  WavePress Color Palette — Premium Dark      -->
    <!-- ============================================ -->

    <!-- Background layers (deeper, richer) -->
    <Color x:Key="BackgroundDark">#0A0A14</Color>
    <Color x:Key="BackgroundMain">#0E0E1A</Color>
    <Color x:Key="SurfaceColor">#161625</Color>
    <Color x:Key="SurfaceLight">#1E1E32</Color>
    <Color x:Key="SurfaceHover">#282845</Color>
    <Color x:Key="BorderColor">#2D2D48</Color>
    <Color x:Key="BorderLight">#3A3A5C</Color>

    <!-- Primary accent — Vibrant Cyan -->
    <Color x:Key="PrimaryColor">#00D4FF</Color>
    <Color x:Key="PrimaryLight">#5CE5FF</Color>
    <Color x:Key="PrimaryDark">#0090B8</Color>
    <Color x:Key="PrimaryMuted">#0D2A38</Color>
    <Color x:Key="PrimaryGlow">#1A00D4FF</Color>

    <!-- Secondary accent — Electric Violet -->
    <Color x:Key="SecondaryColor">#8B5CF6</Color>
    <Color x:Key="SecondaryLight">#B794F6</Color>
    <Color x:Key="SecondaryDark">#6D28D9</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F5F5FF</Color>
    <Color x:Key="TextSecondary">#B0B0CC</Color>
    <Color x:Key="TextMuted">#6B6B8A</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Status colors -->
    <Color x:Key="SuccessColor">#22D3AE</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>

    <!-- ============================================ -->
    <!--  SolidColorBrushes                           -->
    <!-- ============================================ -->

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BackgroundMainBrush" Color="{StaticResource BackgroundMain}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="{StaticResource PrimaryMuted}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- ============================================ -->
    <!--  Gradient Brushes (Premium)                  -->
    <!-- ============================================ -->

    <!-- Gradient for primary accent elements -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00D4FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Sidebar gradient (deeper, more premium) -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111122" Offset="0" />
        <GradientStop Color="#0A0A14" Offset="1" />
    </LinearGradientBrush>

    <!-- Header gradient with subtle accent -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#111122" Offset="0" />
        <GradientStop Color="#0E0E1A" Offset="0.7" />
        <GradientStop Color="#0E0E1A" Offset="1" />
    </LinearGradientBrush>

    <!-- Card glass-effect gradient (subtle top-to-bottom) -->
    <LinearGradientBrush x:Key="CardGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1C1C30" Offset="0" />
        <GradientStop Color="#141422" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent line gradient for card borders/accents -->
    <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D4FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Title bar button hover -->
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#2A2A40" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />

    <!-- Progress bar gradient -->
    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D4FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Sidebar active indicator -->
    <LinearGradientBrush x:Key="SidebarActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00D4FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
