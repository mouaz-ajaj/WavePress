<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!--  WavePress Color Palette — Dark Theme        -->
    <!-- ============================================ -->

    <!-- Background layers -->
    <Color x:Key="BackgroundDark">#0F0F1A</Color>
    <Color x:Key="BackgroundMain">#14141F</Color>
    <Color x:Key="SurfaceColor">#1E1E2E</Color>
    <Color x:Key="SurfaceLight">#2A2A3E</Color>
    <Color x:Key="SurfaceHover">#33334A</Color>
    <Color x:Key="BorderColor">#3A3A52</Color>
    <Color x:Key="BorderLight">#4A4A66</Color>

    <!-- Primary accent — Cyan/Teal -->
    <Color x:Key="PrimaryColor">#00B4D8</Color>
    <Color x:Key="PrimaryLight">#48CAE4</Color>
    <Color x:Key="PrimaryDark">#0077B6</Color>
    <Color x:Key="PrimaryMuted">#1A3A4A</Color>

    <!-- Secondary accent — Violet -->
    <Color x:Key="SecondaryColor">#7C3AED</Color>
    <Color x:Key="SecondaryLight">#A78BFA</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F0F0F8</Color>
    <Color x:Key="TextSecondary">#A0A0B8</Color>
    <Color x:Key="TextMuted">#6B6B82</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Status colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- ============================================ -->
    <!--  SolidColorBrushes                           -->
    <!-- ============================================ -->

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BackgroundMainBrush" Color="{StaticResource BackgroundMain}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="{StaticResource PrimaryMuted}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
        <GradientStop Color="{StaticResource SecondaryColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A2E" Offset="0" />
        <GradientStop Color="#0F0F1A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1A2E" Offset="0" />
        <GradientStop Color="#14141F" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
